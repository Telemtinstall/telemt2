# Option A: run ./telemt-clone-bootstrap.sh without arguments and it will ask
# these values interactively, then save telemt-clone.env with mode 600.
#
# Option B: copy this file to telemt-clone.env and fill values before running:
#   cp telemt-clone.env.example telemt-clone.env
#   nano telemt-clone.env
#   ASSUME_YES=1 ./telemt-clone-bootstrap.sh telemt-clone.env

# Required: DNS name already pointing to the new server public IPv4.
PUBLIC_HOST="proxy.example.com"

# Optional but recommended for Let's Encrypt renewal notices.
LETSENCRYPT_EMAIL="admin@example.com"

# Optional. If empty, the script detects the server's public IPv4.
PUBLIC_IP=""

# Telemt user secret. Leave empty to generate a new one.
# Reusing the old secret keeps old users' secret value, but the host/domain in the link will still change.
TELEMT_SECRET=""

# Current production limit is 1000.
TELEMT_MAX_TCP_CONNS="1000"

# WireGuard is required to reproduce the current setup.
# Do not reuse the old server's WG private key/address while both servers are online.
WG_ADDRESS="10.200.0.X/24"

# Leave empty to generate a new private key during install.
WG_PRIVATE_KEY=""

WG_PEER_PUBLIC_KEY="REPLACE_WITH_EXIT_SERVER_PUBLIC_KEY"
WG_ENDPOINT="203.0.113.10:51820"
WG_ALLOWED_IPS="0.0.0.0/0"
WG_PERSISTENT_KEEPALIVE="25"

# Public IP seen by Telegram middle proxy after WG is up.
# Usually this is the WireGuard exit IP. Leave empty to use WG_ENDPOINT host or auto-detect.
TELEMT_NAT_IP="203.0.113.10"

# SSH port to configure.
SSH_PORT="122"

# Optional and dangerous: disable SSH password login and keep root key-only.
# Default is off. To enable it, root must already have a public key in
# /root/.ssh/authorized_keys and both values below must be yes.
SSH_KEY_ONLY_LOGIN="no"
SSH_KEY_ONLY_CONFIRM="no"

# Optional. Default is off because these are not required for Telemt itself.
ENABLE_FAIL2BAN="no"
ADD_SWAP="no"

# Safety switches.
ASSUME_YES="0"
ALLOW_DNS_MISMATCH="0"
REQUIRE_WG_HANDSHAKE="1"
